# SQLite database file used by Prisma.
DATABASE_URL="file:./dev.db"

# Google Cloud OAuth client (APIs & Services > Credentials).
# Add http://localhost:3000/api/auth/google/callback as an authorized redirect URI
# (and your deployed URL's equivalent in production).
# Enable the "Gmail API" for the project.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# Anthropic API key used to generate AI reply drafts.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# 32-byte (64 hex chars) key used to encrypt OAuth tokens at rest, and to
# sign session cookies. Generate one with:
#   openssl rand -hex 32
ENCRYPTION_KEY=""
SESSION_SECRET=""

# Public base URL of this app (used for OAuth redirects when not localhost).
APP_URL="http://localhost:3000"
